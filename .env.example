# Shared secret for POST/PUT /api/crm.
# Send it as the x-crm-ingest-secret header, or as Authorization: Bearer <secret>.
CRM_INGEST_SECRET=

# Private Vercel Blob store token. On Vercel, linking a Blob store injects
# BLOB_STORE_ID and OIDC automatically; set this token for local writes against
# that store, or when the runtime cannot use OIDC.
BLOB_READ_WRITE_TOKEN=

# Optional. Used only when no Blob store is configured (local dev).
# CRM_LOCAL_STORE=.data/crm.json
